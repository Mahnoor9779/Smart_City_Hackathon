# Every key this project reads. No values. Copy to .env.local and fill in.
# src/lib/env.ts parses and validates this at boot, so a missing required key
# is a startup failure with a clear message, never a runtime undefined.

# ---- Public. Inlined into the browser bundle. Never put a secret here. ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GRID_VERSION=v1
NEXT_PUBLIC_FOCUS_DISTRICT=lahore
# 9 union council, 8 town, 7 tehsil, 6 district. Set to the finest level OSM
# actually covers for Lahore. Printed in the interface footer so the map never
# implies a precision the data does not have.
NEXT_PUBLIC_ADMIN_LEVEL=9
NEXT_PUBLIC_TILES_URL=/tiles/lahore.pmtiles
# live | fixture. Fixture replays recorded responses so the demo survives a
# dead venue network. Rehearse at least once in fixture mode, offline.
NEXT_PUBLIC_DATA_MODE=live
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ---- Server only. ADR-7. Never prefix any of these with NEXT_PUBLIC_. ----
# A key in client code is a key you have published.
OPENAQ_API_KEY=
AQICN_TOKEN=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Salt for hashing submitter IP addresses. Never store a raw IP.
# Losing this orphans every reputation row, so set it once and keep it.
SERVER_SALT=

# Web push. Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.org

# Optional
SENTRY_DSN=
